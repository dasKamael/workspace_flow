<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The sandbox is deliberately off: positioning other apps' windows through
	     AXUIElement, launching arbitrary apps and writing /etc/hosts are all
	     impossible inside it. Distribution is Developer ID + notarisation,
	     not the Mac App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
